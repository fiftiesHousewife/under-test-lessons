{
  "consumer": {
    "name": "order-screen"
  },
  "interactions": [
    {
      "description": "a request for the kettle's stock",
      "key": "62660420",
      "pending": false,
      "providerStates": [
        {
          "name": "three kettles are in stock"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/stock/KETTLE-01"
      },
      "response": {
        "body": {
          "content": {
            "available": 3,
            "sku": "KETTLE-01"
          },
          "contentType": "application/json; charset=UTF-8",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json; charset=UTF-8"
          ]
        },
        "matchingRules": {
          "body": {
            "$.available": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json(;\\s?charset=[\\w\\-]+)?"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.7"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "stock-service"
  }
}
