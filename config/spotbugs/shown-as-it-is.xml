<?xml version="1.0" encoding="UTF-8"?>
<!-- Code a lesson shows as it really is, left out of SpotBugs: today's code, old code and the weak tests. -->
<FindBugsFilter>
  <Match>
    <Package name="~.*\.(today|legacy)(\..*)?"/>
  </Match>
  <Match>
    <Class name="~.*WeakTest"/>
  </Match>
</FindBugsFilter>
